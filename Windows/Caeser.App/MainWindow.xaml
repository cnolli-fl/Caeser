<Window
    x:Class="Caeser.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Caeser.App.Controls"
    Title="Caeser">
    <Grid x:Name="Root" Language="pt-BR" Background="{ThemeResource CaeserBackground}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="DownloadShortcut" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LinkShortcut" />
            <KeyboardAccelerator Key="Escape" Invoked="CancelShortcut" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="CaptionInset" Width="144" /></Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Background="Transparent">
                <TextBlock Text="Caeser" FontWeight="SemiBold" FontSize="14" Margin="20,0,0,0"
                    VerticalAlignment="Center" Foreground="{ThemeResource CaeserForeground}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="WhatsNewButton" Style="{StaticResource CaeserToolbarButton}" Click="WhatsNew_Click" AutomationProperties.Name="Novidades desta versão" ToolTipService.ToolTip="Novidades desta versão">
                <FontIcon Glyph="&#xE8A5;" FontSize="16" />
            </Button>
            <Button Content="Atualizar" Visibility="{Binding UpdateVisibility}" Click="Updates_Click" VerticalAlignment="Center" />
            <Button x:Name="HistoryButton" Style="{StaticResource CaeserToolbarButton}" Click="History_Click" AutomationProperties.Name="Histórico" ToolTipService.ToolTip="Histórico">
                <FontIcon Glyph="&#xE81C;" FontSize="16" />
            </Button>
            <Button x:Name="UpdatesButton" Style="{StaticResource CaeserToolbarButton}" Click="Updates_Click" AutomationProperties.Name="Verificar atualizações" ToolTipService.ToolTip="Verificar atualizações">
                <FontIcon Glyph="&#xE895;" FontSize="16" />
            </Button>
            <Button x:Name="PrimaryAction" Style="{StaticResource AccentButtonStyle}"
                Height="34" MinHeight="34" VerticalAlignment="Center"
                CornerRadius="17" Padding="16,0" Margin="0,0,12,0"
                IsEnabled="{Binding CanStart}" Click="Download_Click" ToolTipService.ToolTip="Baixar: Ctrl+Enter · Cancelar: Esc"
                AutomationProperties.AutomationId="download-action">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{Binding ActionGlyph}" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ActionLabel" Text="{Binding ActionTitle}" FontSize="14" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
            <Border x:Name="ContentFrame" MaxWidth="800" Width="{Binding ViewportWidth, ElementName=MainScroll}"
                Padding="32" HorizontalAlignment="Center">
                <StackPanel Spacing="26">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="68" Height="68" CornerRadius="17">
                            <Image Source="ms-appx:///Assets/CaeserLogo.png" Stretch="Uniform"
                                AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="5">
                            <TextBlock Text="Caeser" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource CaeserForeground}"
                                AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="Vídeos e músicas. Do link à sua pasta." Style="{StaticResource CaeserBody}"
                                Foreground="{ThemeResource CaeserSecondary}" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{ThemeResource CaeserSurface}" BorderBrush="{ThemeResource CaeserBorder}"
                        BorderThickness="0.5" CornerRadius="20" Padding="24">
                        <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False">
                        <StackPanel Spacing="22">
                            <TextBlock Text="Novo download" Style="{StaticResource CaeserHeading}" AutomationProperties.HeadingLevel="Level2" />
                            <controls:SourceSelector x:Name="SourceBar" SelectionChanged="Source_Changed" />
                            <StackPanel Spacing="9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LinkLabel}" FontSize="14" FontWeight="SemiBold"
                                        Foreground="{ThemeResource CaeserForeground}" VerticalAlignment="Center" />
                                    <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource CaeserLink}" Click="Paste_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE77F;" FontSize="15" AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="Colar" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="UrlBox" Text="{Binding UrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding Placeholder}" FontSize="14" MinHeight="34" CornerRadius="8"
                                    AutomationProperties.Name="{Binding LinkLabel}" AutomationProperties.AutomationId="download-url"
                                    AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
                                <TextBlock Text="{Binding LinkHelp}" Style="{StaticResource CaeserHelp}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{Binding PreviewBusyVisibility}">
                                    <ProgressRing Width="18" Height="18" IsActive="{Binding PreviewBusy}" />
                                    <TextBlock Text="{Binding PreviewLoadingText}" Style="{StaticResource CaeserHelp}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding PreviewMessageVisibility}" Spacing="4">
                                    <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource CaeserHelp}" />
                                    <Button Content="Tentar prévia novamente" Style="{StaticResource CaeserLink}" Click="PreviewRetry_Click" />
                                </StackPanel>
                                <Border x:Name="PreviewCard" Padding="14" CornerRadius="14" Background="{ThemeResource CaeserSelector}" Visibility="{Binding PreviewVisibility}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Border Width="84" Height="64" CornerRadius="10" Background="{ThemeResource CaeserSurface}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE714;" FontSize="24" Foreground="{ThemeResource CaeserSecondary}" AutomationProperties.AccessibilityView="Raw" />
                                                    <Image Source="{Binding PreviewArtwork}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock x:Name="PreviewTitleText" Text="{Binding PreviewTitle}" Style="{StaticResource CaeserBody}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PreviewTitle}" />
                                                <TextBlock x:Name="PreviewCreatorText" Text="{Binding PreviewCreator}" Style="{StaticResource CaeserHelp}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding PreviewMatch}" Style="{StaticResource CaeserHelp}" />
                                        <Button Content="Conferir no YouTube" Click="Match_Click" Visibility="{Binding MatchVisibility}" Style="{StaticResource CaeserLink}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Height="0.5" Background="{ThemeResource CaeserBorder}" />
                            <Grid x:Name="OptionsGrid" Visibility="{Binding VideoVisibility}" ColumnSpacing="24" RowSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Qualidade" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CaeserForeground}" />
                                    <ComboBox x:Name="QualityPicker" ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding Quality, Mode=TwoWay}"
                                        DisplayMemberPath="Label" Visibility="{Binding QualityVisibility}" MinHeight="32" CornerRadius="16"
                                        AutomationProperties.Name="Qualidade" />
                                    <TextBlock Text="Melhor áudio disponível" Style="{StaticResource CaeserHelp}"
                                        Visibility="{Binding AudioQualityVisibility}" MinHeight="32" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="FormatPanel" Grid.Column="1" Spacing="9">
                                    <TextBlock Text="Formato" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CaeserForeground}" />
                                    <ComboBox ItemsSource="{Binding FormatChoices}" SelectedItem="{Binding Format, Mode=TwoWay}"
                                        DisplayMemberPath="Label" MinHeight="32" CornerRadius="16" AutomationProperties.Name="Formato" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Converte a melhor faixa de áudio disponível para MP3 em qualidade máxima."
                                    Visibility="{Binding AudioQualityVisibility}" Style="{StaticResource CaeserHelp}" />
                            </Grid>
                            <StackPanel x:Name="SpotifyExplanation" Visibility="{Binding SpotifyVisibility}" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <BitmapIcon UriSource="ms-appx:///Assets/SpotifyMark.png" Width="30" Height="20"
                                        Foreground="{ThemeResource CaeserForeground}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Spotify" Style="{StaticResource CaeserBody}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="13" Foreground="{ThemeResource CaeserSecondary}" AutomationProperties.AccessibilityView="Raw" />
                                    <BitmapIcon UriSource="ms-appx:///Assets/YouTubeMark.png" Width="30" Height="20"
                                        Foreground="{ThemeResource CaeserForeground}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="YouTube" Style="{StaticResource CaeserBody}" VerticalAlignment="Center" />
                                    <Border CornerRadius="10" Background="{ThemeResource CaeserSelector}" Padding="10,4">
                                        <TextBlock Text="MP3" Style="{StaticResource CaeserHelp}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="O áudio vem do YouTube. O MP3 inclui capa, artista e álbum." Style="{StaticResource CaeserHelp}" />
                                <TextBlock Text="Melhor áudio disponível" Style="{StaticResource CaeserBody}" />
                                <TextBlock Text="A busca é automática e pode encontrar outra versão da música." Style="{StaticResource CaeserHelp}" />
                            </StackPanel>
                            <Border Height="0.5" Background="{ThemeResource CaeserBorder}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource CaeserSecondary}" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Salvar em" Style="{StaticResource CaeserHelp}" />
                                    <TextBlock Text="{Binding Destination}" FontWeight="SemiBold" FontSize="14"
                                        TextTrimming="CharacterEllipsis" Foreground="{ThemeResource CaeserForeground}"
                                        ToolTipService.ToolTip="{Binding Destination}" />
                                </StackPanel>
                                <Button x:Name="FolderButton" Grid.Column="2" Content="Alterar…" MinHeight="30" CornerRadius="8" Click="Folder_Click" />
                            </Grid>
                        </StackPanel>
                        </ContentControl>
                    </Border>
                    <StackPanel Visibility="{Binding QueueVisibility}" Spacing="14" Margin="4,0">
                        <Grid>
                            <TextBlock Text="{Binding QueueTitle}" Style="{StaticResource CaeserHeading}" FontSize="15" />
                            <Button Content="{Binding PauseTitle}" Click="Pause_Click" Style="{StaticResource CaeserLink}" HorizontalAlignment="Right" />
                        </Grid>
                        <Expander Header="Organizar fila" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding QueueItems}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource CaeserHelp}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource CaeserToolbarButton}" AutomationProperties.Name="Organizar download" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            <Button.Flyout><MenuFlyout>
                                                <MenuFlyoutItem Text="Mover para cima" Click="QueueUp_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="Mover para baixo" Click="QueueDown_Click" Tag="{Binding}" />
                                                <MenuFlyoutItem Text="Remover da fila" Click="QueueRemove_Click" Tag="{Binding}" />
                                            </MenuFlyout></Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                        <Button Content="Cancelar download atual" Click="CancelCurrent_Click" Visibility="{Binding BusyVisibility}" Style="{StaticResource CaeserLink}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ActivityVisibility}" Spacing="12" Margin="4,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaeserHeading}" FontSize="14"
                                    AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource CaeserHelp}"
                                    IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Mostrar no Explorador" Visibility="{Binding RevealVisibility}"
                                Style="{StaticResource CaeserLink}" Click="Reveal_Click" VerticalAlignment="Top" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                            Visibility="{Binding BusyVisibility}" Foreground="{ThemeResource CaeserAccent}" AutomationProperties.Name="Progresso do download" />
                        <Grid Visibility="{Binding BusyVisibility}">
                            <TextBlock Text="{Binding Speed}" Style="{StaticResource CaeserHelp}" />
                            <TextBlock Text="{Binding Eta}" Style="{StaticResource CaeserHelp}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="14" Margin="4,0">
                        <TextBlock Text="{Binding ToolStatus}" Style="{StaticResource CaeserHelp}" />
                        <Expander Header="Detalhes e ferramentas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding ToolDetails}" Style="{StaticResource CaeserHelp}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Verificar ferramentas" Style="{StaticResource CaeserLink}" Click="Verify_Click" IsEnabled="{Binding IsIdle}" />
                                    <Button Content="Copiar registro" Style="{StaticResource CaeserLink}" Click="Copy_Click" IsEnabled="{Binding HasLogs}" />
                                    <Button Content="Limpar" Style="{StaticResource CaeserLink}" Click="Clear_Click" IsEnabled="{Binding IsIdle}" />
                                </StackPanel>
                                <TextBox x:Name="LogBox" Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True"
                                    Height="160" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    AutomationProperties.Name="Registro do download" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
