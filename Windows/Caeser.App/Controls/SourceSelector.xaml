<UserControl
    x:Class="Caeser.App.Controls.SourceSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40" AutomationProperties.Name="Origem do link">
    <UserControl.Resources>
        <Style x:Key="SourceButton" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HitArea" Background="Transparent" CornerRadius="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HitArea.Background" Value="{ThemeResource ControlSubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="HitArea.Opacity" Value="0.5" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource CaeserForeground}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource CaeserOnAccent}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Track" Background="{ThemeResource CaeserSelector}"
        BorderBrush="{ThemeResource CaeserBorder}" BorderThickness="0.5" CornerRadius="11"
        Padding="3" SizeChanged="Track_SizeChanged" KeyDown="Track_KeyDown">
        <Grid x:Name="Inner">
            <Border x:Name="Thumb" HorizontalAlignment="Left"
                Background="{ThemeResource CaeserAccent}" CornerRadius="8" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="ThumbTranslation" /></Border.RenderTransform>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ToggleButton x:Name="YouTubeButton" Style="{StaticResource SourceButton}"
                    AutomationProperties.Name="YouTube" AutomationProperties.AutomationId="source-youtube"
                    ToolTipService.ToolTip="Baixar de um link de vídeo" Click="YouTube_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <BitmapIcon UriSource="ms-appx:///Assets/YouTubeMark.png" Width="36" Height="24" ShowAsMonochrome="True"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="YouTube" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SpotifyButton" Grid.Column="1" Style="{StaticResource SourceButton}"
                    AutomationProperties.Name="Spotify" AutomationProperties.AutomationId="source-spotify"
                    ToolTipService.ToolTip="Buscar músicas do Spotify no YouTube" Click="Spotify_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <BitmapIcon UriSource="ms-appx:///Assets/SpotifyMark.png" Width="36" Height="24" ShowAsMonochrome="True"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Spotify" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
